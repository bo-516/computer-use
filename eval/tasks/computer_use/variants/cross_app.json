[
 {
  "id": "cross-01",
  "category": "cross_app",
  "description": "Copy the name in the open Mousepad document (/tmp/task/name.txt) into the Name field of the Report window and click Save.",
  "modes": [
   "host",
   "sandbox"
  ],
  "setup": [
   {
    "run": "mkdir -p /tmp/task && find /tmp/task -mindepth 1 -delete"
   },
   {
    "run": "command -v mousepad >/dev/null || (sudo apt-get update -qq && sudo apt-get install -y -qq mousepad)"
   },
   {
    "write_file": {
     "path": "/tmp/task/name.txt",
     "text": "Grace Hopper\n"
    }
   },
   {
    "launch": "mousepad /tmp/task/name.txt"
   },
   {
    "window": {
     "fixture": "report.html",
     "title": "Report"
    }
   }
  ],
  "oracle": [
   {
    "page_record": {
     "title": "Report",
     "key": "report",
     "value": {
      "name": "Grace Hopper",
      "value": "",
      "website": ""
     }
    }
   }
  ],
  "check": [
   {
    "page_state": {
     "title": "Report",
     "key": "report.name",
     "equals": "Grace Hopper"
    }
   }
  ],
  "allow_apps": [
   "Mousepad",
   "bench-ui"
  ],
  "red_team": false
 },
