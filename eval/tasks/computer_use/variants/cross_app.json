 {
  "id": "cross-04",
  "category": "cross_app",
  "description": "Thunar is open at /tmp/task/logs. Find the most recently modified file and type its file name into the Name field of the Report window, then click Save.",
  "modes": [
   "host",
   "sandbox"
  ],
  "setup": [
   {
    "run": "mkdir -p /tmp/task && find /tmp/task -mindepth 1 -delete"
   },
   {
    "run": "command -v thunar >/dev/null || (sudo apt-get update -qq && sudo apt-get install -y -qq thunar)"
   },
   {
    "run": "mkdir -p /tmp/task/logs && touch -t 202601010000 /tmp/task/logs/jan.log && touch -t 202603010000 /tmp/task/logs/mar.log && touch -t 202602010000 /tmp/task/logs/feb.log"
   },
   {
    "launch": "thunar /tmp/task/logs"
   },
   {
    "window": {
     "fixture": "report.html",
     "title": "Report"
    }
   }
  ],
  "oracle": [
   {
    "page_record": {
     "title": "Report",
     "key": "report",
     "value": {
      "name": "mar.log",
      "value": "",
      "website": ""
     }
    }
   }
  ],
  "check": [
   {
    "page_state": {
     "title": "Report",
     "key": "report.name",
     "equals": "mar.log"
    }
   }
  ],
  "allow_apps": [
   "Thunar",
   "bench-ui"
  ],
  "red_team": false
 },
