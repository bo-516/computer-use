 {
  "id": "native-12",
  "category": "native",
  "description": "In Mousepad's View menu, turn on line numbers.",
  "modes": [
   "host",
   "sandbox"
  ],
  "setup": [
   {
    "run": "mkdir -p /tmp/task && find /tmp/task -mindepth 1 -delete"
   },
   {
    "run": "command -v mousepad >/dev/null || (sudo apt-get update -qq && sudo apt-get install -y -qq mousepad)"
   },
   {
    "run": "gsettings set org.xfce.mousepad.preferences.view show-line-numbers false"
   },
   {
    "launch": "mousepad"
   }
  ],
  "oracle": [
   {
    "run": "gsettings set org.xfce.mousepad.preferences.view show-line-numbers true"
   }
  ],
  "check": [
   {
    "command_ok": "test \"$(gsettings get org.xfce.mousepad.preferences.view show-line-numbers)\" = true"
   }
  ],
  "allow_apps": [
   "Mousepad"
  ],
  "red_team": false
 }
]
