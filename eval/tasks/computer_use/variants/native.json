 {
  "id": "native-06",
  "category": "native",
  "description": "Using Thunar (open at /tmp/task), rename draft.txt to final.txt.",
  "modes": [
   "host",
   "sandbox"
  ],
  "setup": [
   {
    "run": "mkdir -p /tmp/task && find /tmp/task -mindepth 1 -delete"
